
#include "raylib.h"

int main()
{
    //1.0 - Definição do tamanho da janela que nn será alterado
    const int larguraTela = 1280;
    const int alturaTela = 720;
    
    //1.1 - Inicia a tela no usuario(VAR:LArgura/Altura/Nome da Janela)
    InitWindow(larguraTela, alturaTela, "Hamburger Hunter");
    SetTargetFPS(60);

    //1.2 - Texture2D: é um dado da biblioteca que armazena uma imagem
    //       LoadTexture:Função  que carrega a imagem dos dados
    Texture2D fundo = LoadTexture("assets/menu_animado.png");
    
    //1.3 - Verificação se a imagem foi carregada;
    //TraceLog:Manda uma mensagem para o terminal de erro;
    //CloseWindo():Fecha a janela do jogo
    if (fundo.id == 0)
    {
        TraceLog(LOG_ERROR, "Nao foi possivel carregar a imagem!");
        CloseWindow();
        return 1;
    }

    //1.4 - Criação da matriz das imagens(Na interface o jogo colocará várias imagens fazendo um video);
    //Definição de Var da matriz, e calculo de imagens em um arquivo;
    const int colunas = 3;
    const int linhas = 3;
    const int totalFrames = colunas * linhas;

    //1.5 - Descobrindo o tamanho de cada imagem do arquivo;
    // o calculo é simples pega a largura total(fundo.width) e a altura total(fundo.height) e divide pela qnt de colunas e linhas
    // assim calculando aproximadamento o tamanho de cada imagem;
    float larguraFrame = fundo.width / (float)colunas;
    float alturaFrame = fundo.height / (float)linhas;

    //1.6 - Calculo da animação(tempo de tela):
    //frameAtual:conta em qual quadro estamos
    //tempo:conta quanto tempo passou
    int frameAtual = 0;
    float tempo = 0.0f;

    //Define quanto tempo cada imagem fica na tela, valores mais altos mais tempo de tela, valores mais próximos de 0 menos tempo de tela;
    float velocidadeAnimacao = 0.70f;

    //OBS:definimos la em cima 60 FPS, isto é, a função frame por segundo suaviza o efeito pixelado, contudo, queremos deixar o jogo o mais retro possivél assim fazendo com que ele fique mais pixelado;
    SetTextureFilter(fundo, TEXTURE_FILTER_POINT);

    //1.7 - Loop de ciclo cas imagens:
    while (!WindowShouldClose())
    {
        // Atualiza o tempo geral das imagens
        tempo += GetFrameTime();

        // Aqui vemos se o tempo total ja cehgou a velocidade da imagem
        if (tempo >= velocidadeAnimacao)
        {//ciclo para reinicar as imagens assim conseguiremos fazer vários loops e nn só um;
            tempo = 0.0f;

            frameAtual++;

            // Volta ao primeiro quadro depois do nono
            if (frameAtual >= totalFrames)
            {
                frameAtual = 0;
            }
        }

        // Descobre em qual coluna e linha esta o quadro
        int colunaAtual = frameAtual % colunas;
        int linhaAtual = frameAtual / colunas;

        //1.8 - Achando o quadro entre os 9:
        // RECTANGLE: comando que faz/corta um retângulo
        Rectangle origem = {
            colunaAtual * larguraFrame,
            linhaAtual * alturaFrame,
            larguraFrame,
            alturaFrame
        };

        //1.9 - Coloca na tela a imagem recortada acima
        Rectangle destino = {
            0,
            0,
            (float)larguraTela,
            (float)alturaTela
        };
        
        //Vector2: comando que armazena cordenadas no raylib;
        Vector2 origemImagem = { 0, 0 };

        BeginDrawing();

        ClearBackground(BLACK);

        //2.0 - Desenhando o quadro na tela:
        //DRAWTEXTUREPRO:desenha a textura com base no controle q vc disser:
        // Imagem carregada/Parte que queremos recortar/Onde e tamanho/PNT de referência/ângulo de rotação/Cor de referência
        DrawTexturePro(
            fundo,
            origem,
            destino,
            origemImagem,
            0.0f,
            WHITE
        );

        EndDrawing();

        //2.1 - Fim da interface e inicio do jogo
        if (IsKeyPressed(KEY_ENTER))
        {
            break;
        }
    }

    // Libera a imagem e fecha a janela
    UnloadTexture(fundo);
    CloseWindow();

    return 0;
}
